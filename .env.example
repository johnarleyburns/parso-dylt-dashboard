# Oilfield Solo — single-server environment contract.
# Local dev: copy to .env (gitignored) and fill in EIA_API_KEY.
# Production: this maps to /opt/oilfield/env on the IONOS box.

# Identity / geo (shown in the dashboard)
NODE_NAME=solo
NODE_PROVIDER=ionos

# HTTP(S) listen address (internal; nginx SNI forwards :443 here in prod)
ADDR=:8444

# SQLite database file (created on first run)
DB_PATH=./.data/oilfield.db

# TLS (self-signed origin cert; Cloudflare must be set to "Full")
TLS_CERT=./.data/certs/cert.pem
TLS_KEY=./.data/certs/key.pem

# Frontend origin allowed for CORS (same-origin needs none, kept for direct API use)
CORS_ORIGIN=https://oilfield-dash.parso.guru

# Scraper
SCRAPE_INTERVAL=300        # seconds between scrape cycles
SCRAPE_CONCURRENCY=3       # max concurrent source fetches (keep low on the shared box)
SCRAPE_ON_START=true       # run one cycle immediately at boot

# API keys
EIA_API_KEY=               # required for EIA sectors — https://www.eia.gov/opendata/
OILPRICE_API_KEY=          # optional — enables Dubai, Urals, JKM, Singapore, coal, carbon

# Optional: override single-node map marker, JSON
# NODE_GEO={"city":"Berlin","country":"DE","lat":52.52,"lon":13.405}
